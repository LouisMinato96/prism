{
  "name": "prism",
  "version": "0.1.0",
  "description": "Deterministic LLM-orchestrated PR review harness with coverage guarantees",
  "type": "module",
  "bin": {
    "prism": "./bin/prism"
  },
  "scripts": {
    "start": "bun run bin/prism",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.ts' 'bin/prism'",
    "format:check": "prettier --check 'src/**/*.ts' 'bin/prism'"
  },
  "dependencies": {
    "p-limit": "^6.1.0",
    "ts-morph": "^24.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "^3.8.3",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
